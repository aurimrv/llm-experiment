# Copy to .env and set the key. .env is not committed.

LLM_PROVIDER=openrouter
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
LLM_TEMPERATURE=0

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# false sends reasoning.enabled=false. Reasoning tokens are billed as output tokens.
OPENROUTER_REASONING=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Ollama reasoning models fill the context before the JSON answer. false skips that trace.
OLLAMA_THINK=false

# Socket timeout for one chat completion. Separate from program execution.
API_TIMEOUT_SECONDS=120
API_MAX_RETRIES=5
API_RETRY_BACKOFF_SECONDS=2
API_RETRY_BACKOFF_MAX_SECONDS=60

# Pause after every completed call, including successes.
# 3.5s stays under the 20 requests/minute cap on OpenRouter :free models.
# Paid models can use a smaller value. Ollama can use 0.
API_MIN_INTERVAL_SECONDS=3.5

# gcc and the mutant process. A non-terminating mutant is killed here.
EXEC_TIMEOUT_SECONDS=2
